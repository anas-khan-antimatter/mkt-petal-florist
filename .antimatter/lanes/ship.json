{
  "schema": 1,
  "runsOn": "ubuntu-latest",
  "setup": [
    "npm ci"
  ],
  "build": [
    "npm run build"
  ],
  "probes": [
    {
      "kind": "browser",
      "url": "/build"
    },
    {
      "kind": "browser",
      "url": "/shop"
    },
    {
      "kind": "http",
      "url": "/api/order"
    }
  ]
}